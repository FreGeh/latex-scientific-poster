\newif\ifposter@wide
\pgfkeys{/poster paper/.is family,/poster paper,
  width/.store in=\poster@paperwidth,
  height/.store in=\poster@paperheight,
  preset/.is choice,
  preset/a0-portrait/.code={\poster@widefalse
    \pgfkeysalso{width=841mm,height=1189mm}},
  preset/a0-landscape/.code={\poster@widetrue
    \pgfkeysalso{width=1189mm,height=841mm}
    \postersetup{body size=40bp,body leading=49bp,heading size=48bp,
      padding=8mm,gap=8mm}},
  preset/conference-wide/.code={\poster@widetrue
    \pgfkeysalso{width=1400mm,height=900mm}
    \postersetup{body size=38bp,body leading=46bp,heading size=48bp}},
  preset=a0-portrait
}
\NewDocumentCommand{\posterpaper}{O{}m}{%
  \pgfkeys{/poster paper/.cd,preset=#2,#1}%
}
\@onlypreamble\posterpaper

% Wide documents can opt out of automatic newspaper-style columns.
\newif\ifposter@autocolumns
\poster@autocolumnstrue
\pgfkeys{/poster/flow/.is choice,
  /poster/flow/columns/.code={\poster@autocolumnstrue},
  /poster/flow/canvas/.code={\poster@autocolumnsfalse}}
\NewDocumentEnvironment{postercontent}{}{%
  \ifposter@wide\ifposter@autocolumns
    \setlength{\columnsep}{\postergutter}%
    \setlength{\multicolsep}{0pt}%
    \raggedcolumns
    \begin{multicols}{2}%
  \fi\fi
}{%
  \ifposter@wide\ifposter@autocolumns\end{multicols}\fi\fi
}

\newcommand{\poster@frametop}{20mm}

\AddToHook{begindocument/before}{%
  \geometry{paperwidth=\poster@paperwidth,paperheight=\poster@paperheight}%
  \ifposterbrandselected
    \ifposter@wide
      \def\poster@framebottom{32mm}%
      \geometry{top=\dimexpr\poster@frametop+\posteredgeinset\relax}%
    \else
      \def\poster@framebottom{55mm}%
      \geometry{top=125mm}%%
    \fi
    \geometry{bottom=\dimexpr\poster@framebottom+\posteredgeinset\relax}%
  \else
    \geometry{top=\dimexpr\poster@frametop+\posteredgeinset\relax,
      bottom=\dimexpr\poster@frametop+\posteredgeinset\relax}%
    \input{brands/unbranded.tex}%
  \fi
  \hypersetup{pdftitle={\@title},pdfauthor={\@author},
    linkcolor=posterSecondary,citecolor=posterPrimary,urlcolor=posterPrimary}%
}
\pagestyle{empty}

% Reserve a shallower footer on a wide board.
\newcommand{\poster@branding}{%
  \ifposter@wide
    \def\poster@footerbaseline{10mm}%
    \def\poster@webfont{\fontsize{32bp}{36bp}}%
  \else
    \def\poster@footerbaseline{20mm}%
    \def\poster@webfont{\fontsize{50bp}{59bp}}%
  \fi
  \begin{tikzpicture}[remember picture,overlay,every node/.style={outer sep=0pt}]
    \draw[gray,line width=2bp]
      ([xshift=20mm,yshift=-\poster@frametop]current page.north west)
      [rounded corners=20mm] -- ([xshift=-20mm,yshift=-\poster@frametop]current page.north east)
      [sharp corners] -- ([xshift=-20mm,yshift=\poster@framebottom]current page.south east)
      [rounded corners=20mm] -- ([xshift=20mm,yshift=\poster@framebottom]current page.south west)
      [sharp corners] -- cycle;
    \ifposter@wide\else
      \node[anchor=base west,inner sep=0pt] at
        ([xshift=40mm,yshift=-92mm]current page.north west)
        {\adjustbox{max height=60mm}{\posterbrandlogo}};
      \node[anchor=south east,inner sep=0pt,align=left,text=posterMuted,
        font=\fontsize{42bp}{49bp}\selectfont] at
        ([xshift=-40mm,yshift=-96mm]current page.north east)
        {\posterpartnerlogo\ifx\posterpartnerlogo\@empty\else\\\fi
         \poster@institute\\\poster@group};
    \fi
    \node[anchor=base west,inner sep=0pt,font=\fontsize{21bp}{25bp}\selectfont] at
      ([xshift=20mm,yshift=\poster@footerbaseline]current page.south west) {\posterbrandfooter};
    \node[anchor=base east,inner sep=0pt,font=\bfseries\poster@webfont\selectfont] at
      ([xshift=-20mm,yshift=\poster@footerbaseline]current page.south east)
      {\hypersetup{urlcolor=black}\posterbrandwebsite};
  \end{tikzpicture}%
}

