% Each column consumes one weight. Row state is local, including in nested rows.
\ExplSyntaxOn
\clist_new:N \l__poster_weights_clist
\fp_new:N \l__poster_total_fp
\dim_new:N \l__poster_width_dim
\int_new:N \l__poster_index_int
\NewDocumentEnvironment{posterrow}{m}{
  \par
  \clist_set:Nn \l__poster_weights_clist {#1}
  \int_zero:N \l__poster_index_int
  \fp_zero:N \l__poster_total_fp
  \clist_map_inline:Nn \l__poster_weights_clist {
    \fp_compare:nNnF {##1}>{0}{\PackageError{poster}{Column~weights~must~be~positive}{}}
    \fp_add:Nn \l__poster_total_fp {##1}
  }
  \dim_set:Nn \l__poster_width_dim
    {\linewidth-\postergutter*\int_eval:n{\clist_count:N\l__poster_weights_clist-1}}
  \noindent\hbox~to~\linewidth\bgroup\ignorespaces
}{
  \unskip
  \int_compare:nNnF {\l__poster_index_int}={\clist_count:N\l__poster_weights_clist}
    {\PackageError{poster}{Column~count~differs~from~row~weights}{}}
  \egroup\par
}
\NewDocumentCommand{\postercolumn}{+m}{
  \unskip
  \int_incr:N \l__poster_index_int
  \int_compare:nNnTF {\l__poster_index_int}>{\clist_count:N\l__poster_weights_clist}
    {\PackageError{poster}{Too~many~columns~in~row}{}}
    {
      \int_compare:nNnT {\l__poster_index_int}>{1}{\hskip\postergutter\relax}
      \begin{minipage}[t]{\fp_to_dim:n{
        \dim_to_fp:n{\l__poster_width_dim}*
        \clist_item:Nn\l__poster_weights_clist{\l__poster_index_int}/\l__poster_total_fp}}
        \vspace{0pt}\raggedright #1
      \end{minipage}
    }
  \ignorespaces
}
\ExplSyntaxOff

\newtcolorbox{postersection}[2][]{%
  enhanced,arc=\posterradius,
  colframe=\posteraccent,colback=white,
  boxrule=\posterrule,boxsep=0pt,
  left=\posterpadding,right=\posterpadding,top=\posterpadding,bottom=\posterpadding,
  lefttitle=\posterpadding,righttitle=\posterpadding,
  toptitle=\postertitlepadding,bottomtitle=\postertitlepadding,titlerule=0pt,
  title={#2},before skip=0pt,after skip=0pt,
  /utils/exec={\expandafter\tcbset\expandafter{\posterpanelstyle}},
  #1
}

\newcommand{\posterbullets}{%
  \setlength{\leftmargini}{1.15em}%
  \setlength{\itemsep}{0.35em}%
  \setlength{\parsep}{0pt}%
}

\AtBeginDocument{\providecolor{posterSubheading}{named}{cleandark}}
\newcommand{\postersubhead}[1]{%
  \par\addvspace{\posterpargap}{\fontsize{37}{42}\selectfont\bfseries\color{posterSubheading}#1}%
  \par\addvspace{\posterpargap}
}

\AtBeginDocument{%
  \color{cleandark}%
  \setlength{\parskip}{\posterpargap}%
  \setlength{\parindent}{0pt}%
}

\tcbset{poster band/.style={sharp corners=northwest,sharp corners=southeast,
  colbacktitle=\posteraccent,coltitle=\posterbandtext,
  fonttitle=\fontsize{\posterheadsize}{\posterheadsize}\selectfont},
  poster outline/.style={arc=3mm,colbacktitle=white,coltitle=\posteraccent,
  halign title=center,fonttitle=\fontsize{\posterheadsize}{\posterheadsize}\selectfont\bfseries}}
\tcbset{poster callout/.style={}}
\newtcolorbox{postercallout}[2][\posteraccent]{%
  enhanced,arc=3mm,poster band,
  title={#2},colframe=#1,colbacktitle=#1,colback=white,
  fonttitle=\fontsize{35bp}{41bp}\selectfont\mdseries,
  boxrule=1bp,titlerule=0pt,boxsep=0pt,
  left=\posterpadding,right=\posterpadding,
  top=\posterpargap,bottom=\posterpargap,
  lefttitle=\posterpadding,righttitle=\posterpadding,
  toptitle=\postertitlepadding,bottomtitle=\postertitlepadding,
  poster callout}

\newcommand{\poster@titleandauthor}{%
  {\raggedright
    \bfseries\fontsize{\postertitlesize}{\postertitleleading}\selectfont
    \@title\par}%
  {\raggedright\color{posterMuted}\fontsize{34bp}{41bp}\selectfont
    \@author\par}%
}
\newcommand{\makeposterheader}{%
  \ifposterbrandselected
    \AddToHookNext{shipout/background}{\poster@branding}%
  \fi
  \ifposter@wide
    \ifposterbrandselected
      \noindent
      % Align the last text baselines and let the taller block set the header height.
      \begin{minipage}[b]{.65\linewidth}
        \poster@titleandauthor
      \end{minipage}\hfill
      \begin{minipage}[b]{.32\linewidth}
        \raggedleft\color{posterMuted}\fontsize{26bp}{30bp}\selectfont
        \adjustbox{max width=\linewidth,max totalheight=23mm}{\posterbrandlogo}\par
        \ifx\posterpartnerlogo\@empty\else
          \adjustbox{max width=\linewidth,max totalheight=16mm}{\posterpartnerlogo}\par
        \fi
        \poster@institute\par
        \poster@group\par
      \end{minipage}\par
    \else
      \poster@titleandauthor
    \fi

  \else
    \poster@titleandauthor

  \fi
  \posterspacer
  \posterbody
}
\endinput
